MONGODB_URI=mongodb://localhost:27017/invoice_ocr
DB_NAME=invoice_ocr
COLLECTION_NAME=invoices

GOOGLE_CLIENT_ID=your-google-oauth-client-id
JWT_SECRET_KEY=your-secure-jwt-secret-key
