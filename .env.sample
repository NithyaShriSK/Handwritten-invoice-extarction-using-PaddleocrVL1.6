# Invoice Intelligence Assistant & Reporting config
CHAT_CACHE_TTL_MINUTES=5
CHAT_MAX_HISTORY=50
REPORTS_DIRECTORY=reports
MAX_REPORT_RECORDS=5000
OLLAMA_MODEL=llama3:latest
REPORT_RETENTION_DAYS=180
OLLAMA_TIMEOUT_SECONDS=120